#!/usr/bin/env sh

STASH_COUNT=$(git stash list | wc -l | tr -d ' ')
if [ "$STASH_COUNT" -gt 3 ]; then
  echo ""
  echo "⚠️  WARNING: You have $STASH_COUNT git stashes."
  echo "   Stale stashes can pollute rebase/merge operations."
  echo "   Consider cleaning up:"
  echo "     git stash list          # review stashes"
  echo "     git stash clear         # delete all (dangerous — review first)"
  echo "     git stash drop stash@{N} # delete a specific one"
  echo ""
fi

npm run ci:remote && npm run test:e2e:pre-push

# ── Security scan (#197 toolchain: osv-scanner + semgrep) ──
# Both gates BLOCKING (triaged + CVE-clean as of 2026-09-06).
if command -v osv-scanner >/dev/null 2>&1; then
  osv-scanner --lockfile package-lock.json || {
    echo "❌ [pre-push] BLOCKED: known vulnerabilities in package-lock.json — run 'npm audit fix', then 'npm run scan:deps'"
    exit 1
  }
fi
if command -v semgrep >/dev/null 2>&1; then
  semgrep scan --config p/default --metrics=off --quiet --error src/ || {
    echo "❌ [pre-push] BLOCKED: semgrep findings in src/ — run 'npm run scan:code'"
    exit 1
  }
fi