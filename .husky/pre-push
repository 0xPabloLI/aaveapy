#!/usr/bin/env sh

# Every command below needs the toolchain, and a linked git worktree has none
# until `npm install` runs there. Say so instead of letting `npm run ci:remote`
# die on a missing binary (or `npx` quietly fetch one over the network).
if [ ! -d node_modules ]; then
  echo "❌ [pre-push] BLOCKED: node_modules 不存在于 $(pwd)"
  echo "   这是 worktree 未装依赖的典型现场 —— 先在该 worktree 里 npm install，再推送。"
  exit 1
fi

STASH_COUNT=$(git stash list | wc -l | tr -d ' ')
if [ "$STASH_COUNT" -gt 3 ]; then
  echo ""
  echo "⚠️  WARNING: You have $STASH_COUNT git stashes."
  echo "   Stale stashes can pollute rebase/merge operations."
  echo "   Consider cleaning up:"
  echo "     git stash list          # review stashes"
  echo "     git stash clear         # delete all (dangerous — review first)"
  echo "     git stash drop stash@{N} # delete a specific one"
  echo ""
fi

# The `|| { ...; exit 1; }` is load-bearing, not decoration: husky runs this file as
# `sh -e`, and errexit deliberately ignores a failure that happens *inside* an `&&`
# list unless it is the command after the final `&&`. Without the guard, a red
# `ci:remote` skipped the e2e step, stayed silent, and left the hook's exit code to
# the gates below — so lint/typecheck/unit/build/audit failures could be pushed
# (AAV-1330). scripts/hook-failure-propagation.test.mjs runs the real line against a
# stubbed npm to keep that from coming back.
# Keep the guard on ONE line: the test runs the real gate by extracting that line, and
# a multi-line `|| {` block would be extracted as an incomplete (unterminated `{`) snippet.
npm run ci:remote && npm run test:e2e:pre-push || { echo "❌ [pre-push] BLOCKED: ci:remote 或 e2e 失败 — 修根因，不要绕 hook。"; exit 1; }

# ── Security scan (#197 toolchain: osv-scanner + semgrep) ──
# Both gates BLOCKING (triaged + CVE-clean as of 2026-09-06).
if command -v osv-scanner >/dev/null 2>&1; then
  osv-scanner --lockfile package-lock.json || {
    echo "❌ [pre-push] BLOCKED: known vulnerabilities in package-lock.json — run 'npm audit fix', then 'npm run scan:deps'"
    exit 1
  }
fi
if command -v semgrep >/dev/null 2>&1; then
  semgrep scan --config p/default --metrics=off --quiet --error src/ || {
    echo "❌ [pre-push] BLOCKED: semgrep findings in src/ — run 'npm run scan:code'"
    exit 1
  }
fi

# ── Dead code + duplication gates (Level-4 readiness toolchain) ──
npm run knip || {
  echo "❌ [pre-push] BLOCKED: knip found unused files — run 'npm run knip' to inspect"
  exit 1
}
npm run dup:check || {
  echo "❌ [pre-push] BLOCKED: jscpd duplication above 3% threshold — see clones above"
  exit 1
}