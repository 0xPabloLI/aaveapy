{
  "name": "aaveapy",
  "version": "1.0.0",
  "description": "React dashboard for Aave V3 market data with yield comparisons across multiple chains",
  "author": "0xPabloLI <0xpablo.li@proton.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xPabloLI/aaveapy.git"
  },
  "homepage": "https://aaveapy.com",
  "keywords": [
    "aave",
    "defi",
    "yield",
    "apy",
    "dashboard",
    "react",
    "typescript"
  ],
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-token-icon-manifest.mjs && node scripts/generate-chain-icon-manifest.mjs && vite",
    "vite:clear-cache": "node scripts/clear-vite-cache.mjs",
    "dev:fresh": "npm run vite:clear-cache && npm run dev",
    "dev:fresh:staging": "npm run vite:clear-cache && npm run dev:staging",
    "postinstall": "node scripts/clear-vite-cache.mjs",
    "dev:staging": "node scripts/generate-token-icon-manifest.mjs && node scripts/generate-chain-icon-manifest.mjs && VITE_API_BASE_URL=https://staging-api.aaveapy.com/api vite --mode staging",
    "dev:production": "vite --mode production",
    "ci:remote": "npm run lint && npm run check:react-singleton && npm test && npm run build && npm audit --omit=dev --audit-level=high",
    "ci:auto-fix": "npm audit fix --omit=dev || true && npm ci",
    "build": "node scripts/generate-token-icon-manifest.mjs && node scripts/generate-chain-icon-manifest.mjs && vite build",
    "build:dev": "node scripts/generate-token-icon-manifest.mjs && node scripts/generate-chain-icon-manifest.mjs && vite build --mode development",
    "lint": "eslint .",
    "lint:colors": "node scripts/check-semantic-colors.mjs",
    "lint:all": "npm run lint && npm run lint:colors",
    "preflight:release": "node scripts/preflight-release.mjs",
    "preview": "vite preview",
    "sync-token-icons": "node scripts/sync-token-icons.mjs",
    "sync:cloudflare-gh-actions-allowlist": "node scripts/sync-cloudflare-gh-actions-allowlist.mjs",
    "sync:reserve-patches-upstream": "node scripts/sync-reserve-patches-upstream.mjs",
    "sync:market-name-map-upstream": "node scripts/sync-market-name-map-upstream.mjs",
    "sync:chain-icons-upstream": "node scripts/sync-chain-icon-map-upstream.mjs",
    "sync:chain-network-icons-upstream": "node scripts/sync-chain-network-icons-upstream.mjs",
    "sync:coingecko-platform-map": "node scripts/sync-coingecko-platform-map.mjs",
    "hardcode:sync": "npm run sync:reserve-patches-upstream && npm run sync:market-name-map-upstream && npm run sync:chain-icons-upstream && npm run sync:chain-network-icons-upstream && node scripts/generate-chain-icon-manifest.mjs && npm run sync:coingecko-platform-map && npm run sync-token-icons",
    "hardcode:verify": "node scripts/generate-token-icon-manifest.mjs && node scripts/generate-chain-icon-manifest.mjs && npm run check:hardcode-icons && npm run check:reserve-patches-upstream && npm run check:market-name-map-upstream && npm run check:chain-icons-upstream && npm run check:coingecko-platform-map-upstream && npm run sync-token-icons -- --check",
    "check:hardcode-icons": "node scripts/check-hardcode-icons.mjs",
    "check:reserve-patches-upstream": "node scripts/check-reserve-patches-upstream.mjs",
    "check:market-name-map-upstream": "node scripts/check-market-name-map-upstream.mjs",
    "check:coingecko-platform-map-upstream": "node scripts/check-coingecko-platform-map-upstream.mjs",
    "check:chain-icons-upstream": "node scripts/check-chain-icon-map-upstream.mjs",
    "test": "node scripts/generate-token-icon-manifest.mjs && node scripts/generate-chain-icon-manifest.mjs && vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:strict-stick": "STRICT_STICK_ASSERT=true playwright test -g \"strict stick\"",
    "test:live": "LIVE_TEST_API_BASE=https://staging-api.aaveapy.com/api RUN_LIVE_TESTS=true vitest run src/lib/apiSchemas.live.test.ts",
    "test:live:staging": "LIVE_TEST_API_BASE=https://staging-api.aaveapy.com/api RUN_LIVE_TESTS=true vitest run src/lib/apiSchemas.live.test.ts",
    "probe:live-api": "node scripts/probe-live-api.mjs",
    "ci:lockcheck": "npm ci",
    "check:react-singleton": "node scripts/check-react-singleton.mjs"
  },
  "dependencies": {
    "@aave-dao/aave-address-book": "^4.52.8",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.4.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/supabase-js": "^2.99.3",
    "@tanstack/react-query": "^5.95.0",
    "@tanstack/react-virtual": "^3.13.23",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "baseline-browser-mapping": "^2.10.10",
    "caniuse-lite": "^1.0.30001780",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-day-picker": "^8.10.1",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "react-resizable-panels": "^4.7.5",
    "react-router-dom": "^6.30.4",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9",
    "zod": "^4.4.3"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "@types/react": "$@types/react",
    "@types/react-dom": "$@types/react-dom"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^10.0.3",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "lovable-tagger": "^1.3.0",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.10",
    "rollup": "^4.60.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.0"
  }
}
