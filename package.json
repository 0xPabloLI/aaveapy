{
  "name": "aaveapy",
  "version": "1.0.0",
  "description": "React dashboard for Aave V3 market data with yield comparisons across multiple chains",
  "author": "0xPabloLI <0xpablo.li@proton.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xPabloLI/aaveapy.git"
  },
  "homepage": "https://aaveapy.com",
  "keywords": [
    "aave",
    "defi",
    "yield",
    "apy",
    "dashboard",
    "react",
    "typescript"
  ],
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-token-icon-manifest.mjs && vite",
    "dev:staging": "VITE_API_BASE_URL=https://staging-api.aaveapy.com/api vite --mode staging",
    "dev:production": "vite --mode production",
    "ci:remote": "npm run lint && npm run build && npm audit --omit=dev --audit-level=high",
    "ci:auto-fix": "npm audit fix --omit=dev || true && npm ci",
    "build": "node scripts/generate-token-icon-manifest.mjs && vite build",
    "build:dev": "node scripts/generate-token-icon-manifest.mjs && vite build --mode development",
    "lint": "eslint .",
    "lint:colors": "node scripts/check-semantic-colors.mjs",
    "lint:all": "npm run lint && npm run lint:colors",
    "preflight:release": "node scripts/preflight-release.mjs",
    "preview": "vite preview",
    "sync-token-icons": "node scripts/sync-token-icons.mjs",
    "sync:reserve-patches-upstream": "node scripts/sync-reserve-patches-upstream.mjs",
    "sync:market-name-map-upstream": "node scripts/sync-market-name-map-upstream.mjs",
    "sync:chain-icons-upstream": "node scripts/sync-chain-icon-map-upstream.mjs",
    "hardcode:sync": "npm run sync:reserve-patches-upstream && npm run sync:market-name-map-upstream && npm run sync:chain-icons-upstream && npm run sync-token-icons",
    "hardcode:verify": "npm run check:hardcode-icons && npm run check:reserve-patches-upstream && npm run check:market-name-map-upstream && npm run check:chain-icons-upstream && npm run sync-token-icons -- --check",
    "check:hardcode-icons": "node scripts/check-hardcode-icons.mjs",
    "check:reserve-patches-upstream": "node scripts/check-reserve-patches-upstream.mjs",
    "check:market-name-map-upstream": "node scripts/check-market-name-map-upstream.mjs",
    "check:chain-icons-upstream": "node scripts/check-chain-icon-map-upstream.mjs",
    "test": "vitest run",
    "ci:lockcheck": "npm ci"
  },
  "dependencies": {
    "@bgd-labs/aave-address-book": "^4.38.0",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/supabase-js": "^2.98.0",
"@tanstack/react-query": "^5.90.21",
    "@tanstack/react-virtual": "^3.13.22",
    "@vercel/analytics": "^2.0.1",
    "baseline-browser-mapping": "^2.10.8",
    "caniuse-lite": "^1.0.30001766",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.25.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.71.2",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.3.0",
"autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^7.0.1",
"eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "lovable-tagger": "^1.1.13",
    "postcss": "^8.5.6",
    "rollup": "^4.59.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
