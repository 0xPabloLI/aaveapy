{
  "name": "aaveapy",
  "version": "1.0.0",
  "description": "Aave yield dashboard & simulator — compare supply/borrow APY, capped incentives, and spread across every V3 + V4 pool on 21 chains. Simulate portfolio positions with Merit, Merkl, and Brevis incentive modeling.",
  "author": "0xPabloLI <0xpablo.li@proton.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xPabloLI/aaveapy.git"
  },
  "homepage": "https://aaveapy.com",
  "keywords": [
    "aave",
    "defi",
    "yield",
    "apy",
    "dashboard",
    "react",
    "typescript"
  ],
  "type": "module",
  "scripts": {
    "dev": "node scripts/clear-vite-cache.mjs && node scripts/generate-icon-manifests.mjs && vite",
    "vite:clear-cache": "node scripts/clear-vite-cache.mjs",
    "dev:fresh": "npm run vite:clear-cache && npm run dev",
    "dev:staging": "node scripts/clear-vite-cache.mjs && node scripts/generate-icon-manifests.mjs && VITE_API_BASE_URL=https://staging-api.aaveapy.com/api vite --mode staging",
    "build:staging": "node scripts/generate-icon-manifests.mjs && VITE_API_BASE_URL=${VITE_API_BASE_URL:-https://staging-api.aaveapy.com/api} vite build --mode staging",
    "preview:staging": "VITE_API_BASE_URL=${VITE_API_BASE_URL:-https://staging-api.aaveapy.com/api} vite preview --port 4173 --host 127.0.0.1",
    "postinstall": "node scripts/clear-vite-cache.mjs",
    "dev:production": "vite --mode production",
    "ci:remote": "npm run lint && npm run check:react-singleton && npm test && npm run build && (npm audit --omit=dev --audit-level=high || echo '⚠️  npm audit found vulnerabilities (see CI security-audit job for details)')",
    "ci:auto-fix": "npm audit fix --omit=dev || true && npm ci",
    "build": "node scripts/generate-icon-manifests.mjs && vite build",
    "build:dev": "node scripts/generate-icon-manifests.mjs && vite build --mode development",
    "lint": "eslint .",
    "lint:colors": "node scripts/check-semantic-colors.mjs",
    "lint:all": "npm run lint && npm run lint:colors",
    "preflight:release": "node scripts/preflight-release.mjs",
    "preview": "vite preview",
    "openapi:fetch": "node --experimental-strip-types scripts/fetch-openapi.ts",
    "openapi:check": "node --experimental-strip-types scripts/fetch-openapi.ts && git diff --exit-code -- public/openapi.json",
    "schema:codegen": "openapi-zod-client public/openapi.json -o src/generated/api/schemas.ts --export-schemas --with-alias",
    "schema:check": "npm run schema:codegen && git diff --exit-code -- src/generated/api/",
    "sync-token-icons": "node --experimental-strip-types scripts/sync-token-icons.mjs",
    "sync:cloudflare-gh-actions-allowlist": "node scripts/sync-cloudflare-gh-actions-allowlist.mjs",
    "sync:reserve-patches-upstream": "node scripts/sync-reserve-patches-upstream.mjs",
    "sync:market-name-map-upstream": "node scripts/sync-market-name-map-upstream.mjs",
    "sync:chain-icons-upstream": "node scripts/sync-chain-icon-map-upstream.mjs",
    "sync:chain-network-icons-upstream": "node scripts/sync-chain-network-icons-upstream.mjs",
    "sync:coingecko-platform-map": "node --experimental-strip-types scripts/sync-coingecko-platform-map.mjs",
    "sync:pool-addresses-upstream": "node scripts/sync-pool-addresses-upstream.mjs",
    "check:pool-addresses-upstream": "node scripts/check-pool-addresses-upstream.mjs",
    "check:chain-registry-upstream": "node scripts/check-chain-registry-upstream.mjs",
    "hardcode:sync": "npm run sync:reserve-patches-upstream && npm run sync:market-name-map-upstream && npm run sync:chain-icons-upstream && npm run sync:chain-network-icons-upstream && node scripts/generate-chain-icon-manifest.mjs && npm run sync:coingecko-platform-map && npm run sync-token-icons && npm run sync:pool-addresses-upstream",
    "hardcode:verify": "node scripts/generate-icon-manifests.mjs && npm run check:hardcode-icons && npm run check:reserve-patches-upstream && npm run check:market-name-map-upstream && npm run check:chain-icons-upstream && npm run check:coingecko-platform-map-upstream && npm run sync-token-icons -- --check && npm run check:pool-addresses-upstream && npm run check:chain-registry-upstream",
    "check:hardcode-icons": "node scripts/check-hardcode-icons.mjs",
    "check:reserve-patches-upstream": "node scripts/check-reserve-patches-upstream.mjs",
    "check:market-name-map-upstream": "node scripts/check-market-name-map-upstream.mjs",
    "check:coingecko-platform-map-upstream": "node scripts/check-coingecko-platform-map-upstream.mjs",
    "check:chain-icons-upstream": "node scripts/check-chain-icon-map-upstream.mjs",
    "test": "node scripts/generate-icon-manifests.mjs && vitest run",
    "test:e2e": "playwright test",
    "test:e2e:pre-push": "node scripts/pre-push-e2e.mjs",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:strict-stick": "STRICT_STICK_ASSERT=true playwright test -g \"strict stick\"",
    "test:e2e:api-fields": "playwright test --config=e2e/playwright.fields.config.ts",
    "test:live": "RUN_LIVE_TESTS=true vitest run src/lib/apiSchemas.live.test.ts",
    "test:live:staging": "RUN_LIVE_TESTS=true vitest run src/lib/apiSchemas.live.test.ts",
    "test:live:simulation": "RUN_LIVE_TESTS=true vitest run src/lib/rateSimulationCalculator.live.test.ts",
    "test:live:simulation:local": "LIVE_TEST_API_BASE=http://localhost:3001/api RUN_LIVE_TESTS=true vitest run src/lib/rateSimulationCalculator.live.test.ts",
    "test:live:simulation:staging": "RUN_LIVE_TESTS=true vitest run src/lib/rateSimulationCalculator.live.test.ts",
    "test:live:all": "RUN_LIVE_TESTS=true vitest run src/lib/apiSchemas.live.test.ts src/lib/rateSimulationCalculator.live.test.ts",
    "test:chain-discovery-contract": "RUN_LIVE_TESTS=true vitest run src/lib/userData/chainDiscovery.contract.test.ts",
    "probe:live-api": "node scripts/probe-live-api.mjs",
    "check:campaign-apr-reconcile": "node scripts/reconcile-campaign-apr.mjs",
    "ci:lockcheck": "npm ci",
    "check:react-singleton": "node scripts/check-react-singleton.mjs",
    "prepare": "npx husky"
  },
  "dependencies": {
    "@aave-dao/aave-address-book": "^4.57.2",
    "@aave/react": "^4.2.0",
    "@aave/react-v3": "npm:@aave/react@^0.9.1",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@supabase/supabase-js": "^2.99.3",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-virtual": "^3.13.23",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "baseline-browser-mapping": "^2.10.10",
    "caniuse-lite": "^1.0.30001780",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "esbuild": "^0.28.1",
    "framer-motion": "^13.1.1",
    "i18next": "^26.3.6",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.33.0",
    "next-themes": "^0.4.6",
    "playwright": "^1.61.0",
    "react": "^19.2.4",
    "react-day-picker": "^8.10.1",
    "react-dom": "^19.2.4",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.72.0",
    "react-i18next": "^17.0.8",
    "react-resizable-panels": "^4.7.5",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9",
    "viem": "^2.51.3",
    "wagmi": "^3.6.16",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@types/react": "$@types/react",
    "@types/react-dom": "$@types/react-dom",
    "minimatch@3": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.9"
    },
    "js-yaml": "4.3.1",
    "react": "$react",
    "react-dom": "$react-dom",
    "shell-quote": "1.9.0",
    "ws": "8.21.0",
    "@zodios/core": {
      "zod": "$zod"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lovable-tagger": "^1.3.3",
    "openapi-zod-client": "^1.18.3",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.26",
    "rollup": "^4.62.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
