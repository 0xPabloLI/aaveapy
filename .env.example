# API base URL (optional). If omitted, Vite build uses staging (src/lib/apiBase.ts).
# See docs/conventions/api-base-urls.md for CI variables and script defaults.
VITE_API_BASE_URL=http://localhost:3001/api

# Supabase — required for /admin/seo (Edge Function seo-proxy).
# Lovable Cloud auto-injects these; local dev needs .env.local with real values.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Structured logging level (debug | info | warn | error). Default: debug in
# dev/test, info in production builds. See src/lib/logger.ts.
VITE_LOG_LEVEL=

# Sentry error tracking (optional). Set to a browser SDK DSN to activate;
# unset = fully disabled no-op. See src/lib/sentry.ts.
VITE_SENTRY_DSN=
# Overrides the reported environment name (defaults to the Vite build mode).
# e.g. set to "staging" on the dev-branch deployment to separate staging
# errors from production in the Sentry UI.
VITE_SENTRY_ENVIRONMENT=

# Request tracing header (advanced). When "true", fetchWithTracing sends
# X-Request-ID to the backend. WARNING: requires the backend CORS allow-list
# to include X-Request-ID first — otherwise every API request fails preflight.
# See src/lib/requestContext.ts.
VITE_REQUEST_ID_HEADER=

# Runtime feature flag overrides, highest-priority (after localStorage).
# Format: VITE_FLAG_<NAME>=true|false per flag; defaults in src/config/features.ts.
#VITE_FLAG_EXAMPLE=true

