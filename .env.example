# API base URL (optional). If omitted, Vite build uses staging (src/lib/apiBase.ts).
# See docs/conventions/api-base-urls.md for CI variables and script defaults.
VITE_API_BASE_URL=http://localhost:3001/api

# Supabase — required for /admin/seo (Edge Function seo-proxy).
# Lovable Cloud auto-injects these; local dev needs .env.local with real values.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

