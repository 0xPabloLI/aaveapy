# API base URL (optional). If omitted, Vite build uses staging (src/lib/apiBase.ts).
# See docs/conventions/api-base-urls.md for CI variables and script defaults.
VITE_API_BASE_URL=http://localhost:3001/api

# Show "Rate vs Market" dev check panel even in production build (optional)
# Set to true to compare rate-inputs vs market snapshot (e.g. for debugging).
# VITE_SHOW_RATE_CHECK=true
