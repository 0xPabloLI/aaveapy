include=optional
# NOTE: platform and arch are set to linux/x64 for Lovable deployments
# For local development on macOS/Windows, override these via environment variables:
#   NPM_CONFIG_PLATFORM=darwin npm install  (for macOS)
#   NPM_CONFIG_PLATFORM=win32 npm install  (for Windows)
# Or temporarily comment out the lines below for local development
platform=linux
arch=x64